  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Recruiter workspace profile root"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Recruiter isolated private PII"
    },
    "/users/{userId}/candidates/{candidateId}": {
      "schema": { "$ref": "#/entities/CandidateRecord" },
      "description": "Encrypted candidate profiles owned by recruiter"
    },
    "/users/{userId}/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/JobPostingRecord" },
      "description": "Domestic and international job postings owned by recruiter"
    },
    "/users/{userId}/interviews/{interviewId}": {
      "schema": { "$ref": "#/entities/InterviewRecord" },
      "description": "Encrypted interview schedules owned by recruiter"
    },
    "/users/{userId}/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/JobApplicationRecord" },
      "description": "Direct applicant job submissions for Excel sheet & ATS management"
    },
    "/publicJobs/{publicJobId}": {
      "schema": { "$ref": "#/entities/PublicJobRecord" },
      "description": "Public job snapshots for social media share links"
    }
  }
}
